{
  "name": "portable-music-downloader",
  "version": "0.2.0",
  "private": true,
  "description": "Chrome/Edge music downloader and library manager for devices with standalone music playback, including smart bands, watches and headphones.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm icons:build && vite build --watch --mode development",
    "build": "pnpm icons:build && vite build",
    "icons:build": "node scripts/build-icons.mjs",
    "typecheck": "tsc --noEmit",
    "zip": "node scripts/package-extension.mjs",
    "release:build": "pnpm typecheck && pnpm build && pnpm security:check && pnpm zip",
    "security:check": "node scripts/validate-extension-security.mjs",
    "clean": "node scripts/clean.mjs",
    "cws:check": "node scripts/chrome-web-store-publish.mjs --check",
    "cws:upload": "node scripts/chrome-web-store-publish.mjs --no-publish",
    "cws:publish": "node scripts/chrome-web-store-publish.mjs",
    "edge:upload": "node scripts/edge-addons-publish.mjs --no-publish",
    "edge:publish": "node scripts/edge-addons-publish.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.33",
    "@types/node": "^25.9.3",
    "lucide-static": "1.55.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  }
}
